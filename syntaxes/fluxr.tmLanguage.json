{
  "name": "FluxR",
  "scopeName": "source.fluxr",
  "fileTypes": ["fluxr"],
  "patterns": [
    {
      "name": "meta.module.current.fluxr",
      "begin": "\\A(fluxr 1)$",
      "beginCaptures": { "1": { "name": "keyword.other.version.fluxr" } },
      "end": "(?!)",
      "patterns": [{ "include": "#current" }]
    },
    {
      "name": "meta.rule.fluxr",
      "begin": "^\\s*(r\\+?0*4)(?=\\s)",
      "beginCaptures": { "1": { "name": "keyword.other.version.fluxr" } },
      "end": "(?!)",
      "patterns": [
        { "match": "#.*", "name": "comment.line.number-sign.fluxr" },
        { "include": "#rule" }
      ]
    },
    {
      "name": "meta.rule.fluxr",
      "begin": "^\\s*(r\\+?0*[1-3])(?=\\s)",
      "beginCaptures": { "1": { "name": "keyword.other.version.fluxr" } },
      "end": "(?!)",
      "patterns": [{ "include": "#rule" }]
    },
    {
      "name": "meta.timeline.fluxr",
      "begin": "^\\s*(v\\+?0*1)\\s+(\\+?[0-9]+)\\s*$",
      "beginCaptures": {
        "1": { "name": "keyword.other.version.fluxr" },
        "2": { "name": "constant.numeric.integer.fluxr" }
      },
      "end": "(?!)",
      "patterns": [
        {
          "match": "(?<!\\S)(\\+?[0-9]+)(:)([+-]?[0-9]+)(?!\\S)",
          "captures": {
            "1": { "name": "constant.numeric.integer.fluxr" },
            "2": { "name": "punctuation.separator.key-value.fluxr" },
            "3": { "name": "constant.numeric.integer.fluxr" }
          }
        },
        {
          "match": "^\\s*(\\+?[0-9]+)\\s+(\\+?[0-9]+)\\s+(\\+?0*[0-2])(?!\\S)",
          "captures": {
            "1": { "name": "constant.numeric.integer.fluxr" },
            "2": { "name": "constant.numeric.integer.fluxr" },
            "3": { "name": "constant.numeric.curve.fluxr" }
          }
        }
      ]
    },
    {
      "name": "meta.module.compact.fluxr",
      "begin": "^\\s*(v\\+?0*[12])(?=\\s|\\()",
      "beginCaptures": { "1": { "name": "keyword.other.version.fluxr" } },
      "end": "(?!)",
      "patterns": [{ "include": "#compact" }]
    },
    {
      "name": "meta.gate.fluxr",
      "match": "^\\s*([&|])([a-p]{2,16})\\s*$",
      "captures": {
        "1": { "name": "keyword.operator.logical.fluxr" },
        "2": { "name": "variable.parameter.fluxr" }
      }
    },
    {
      "name": "meta.gate.fluxr",
      "begin": "^\\s*(?=\\()",
      "end": "(?!)",
      "patterns": [
        { "include": "#compact" },
        { "match": "(?<![^\\s()])[a-p](?=[\\s()]|$)", "name": "variable.parameter.fluxr" }
      ]
    },
    { "match": "^\\s*[a-p]\\s*$", "name": "variable.parameter.fluxr" }
  ],
  "repository": {
    "current": {
      "comment": "FluxR 1 tokens use ASCII whitespace boundaries. This is lexical coloring, not counted-prefix parsing or UTF-8 byte-span delimitation; see docs/highlighting.md.",
      "patterns": [
        {
          "name": "string.quoted.double.fluxr invalid.illegal.unterminated-string.fluxr",
          "begin": "(?<![^ \\t\\r\\n\\x0b\\x0c])(\")(?=(?:[^\"\\\\\\n]|\\\\[^\\n])*\\\\?$)",
          "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.fluxr" } },
          "end": "$",
          "patterns": [{ "include": "#current-string-content" }]
        },
        {
          "name": "string.quoted.double.fluxr",
          "begin": "(?<![^ \\t\\r\\n\\x0b\\x0c])(\")",
          "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.fluxr" } },
          "end": "(\")([^ \\t\\r\\n\\x0b\\x0c]*)|$",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.fluxr" },
            "2": { "name": "invalid.illegal.quoted-token.fluxr" }
          },
          "patterns": [{ "include": "#current-string-content" }]
        },
        {
          "match": "(?<![^ \\t\\r\\n\\x0b\\x0c])(?:inputs|rec|enum|fn|pub|method|native-use|native-fn|native-pubfn|native-asyncfn|native-pubasyncfn|rust)(?=[ \\t\\r\\n\\x0b\\x0c]|$)",
          "name": "keyword.declaration.fluxr"
        },
        {
          "match": "(?<![^ \\t\\r\\n\\x0b\\x0c])(?:true|false|unit|none)(?=[ \\t\\r\\n\\x0b\\x0c]|$)",
          "name": "constant.language.fluxr"
        },
        {
          "match": "(?<![^ \\t\\r\\n\\x0b\\x0c])(?:bool|int|uint|float|record|list)(?=[ \\t\\r\\n\\x0b\\x0c]|$)",
          "name": "storage.type.fluxr"
        },
        {
          "match": "(?<![^ \\t\\r\\n\\x0b\\x0c])(?:do|ret|if|while|break|continue|for|return|tail|if-stmt)(?=[ \\t\\r\\n\\x0b\\x0c]|$)",
          "name": "keyword.control.fluxr"
        },
        {
          "match": "(?<![^ \\t\\r\\n\\x0b\\x0c])(?:bump|scale|next|prev|add|sub|mul|div|rem|eq|lt|le|and|or|not)(?=[ \\t\\r\\n\\x0b\\x0c]|$)",
          "name": "keyword.operator.fluxr"
        },
        {
          "match": "(?<![^ \\t\\r\\n\\x0b\\x0c])(?:set|put|push|pop|local|input|new|field|tag|wrap|is|payload|empty|last|at|minidx|call|host|m|abs|tof|i64tof|ftoi64|sqrt|let|var|let-type|path|str|macro|ref|mutref|deref|neg|try|await|unsafe|async|async-move|cast|index|array|tuple|bin|block|move|closure)(?=[ \\t\\r\\n\\x0b\\x0c]|$)",
          "name": "support.function.fluxr"
        },
        {
          "match": "(?<![^ \\t\\r\\n\\x0b\\x0c])(?:0x[0-9a-fA-F]+|-?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)f(?=[ \\t\\r\\n\\x0b\\x0c]|$)",
          "name": "constant.numeric.float.fluxr"
        },
        {
          "match": "(?<![^ \\t\\r\\n\\x0b\\x0c])(?:[0-9]+u|-?[0-9]+)(?=[ \\t\\r\\n\\x0b\\x0c]|$)",
          "name": "constant.numeric.integer.fluxr"
        }
      ]
    },
    "current-string-content": {
      "patterns": [
        {
          "match": "\\\\u[dD][89aAbB][0-9a-fA-F]{2}\\\\u[dD][c-fC-F][0-9a-fA-F]{2}",
          "name": "constant.character.escape.fluxr"
        },
        {
          "match": "\\\\u[dD][89a-fA-F][0-9a-fA-F]{2}",
          "name": "invalid.illegal.escape.fluxr"
        },
        {
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})",
          "name": "constant.character.escape.fluxr"
        },
        {
          "match": "\\\\(?:u[0-9a-fA-F]{0,3}|[^\\n])?",
          "name": "invalid.illegal.escape.fluxr"
        },
        { "match": "[\\x00-\\x1f]", "name": "invalid.illegal.control-character.fluxr" }
      ]
    },
    "rule": {
      "patterns": [
        { "match": "(?<!\\S)i\\+?[0-9]+(?=[\\s#]|$)", "name": "variable.parameter.fluxr" },
        {
          "match": "(?<!\\S)f32:[+-]?(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|(?i:inf(?:inity)?|nan))(?=[\\s#]|$)",
          "name": "constant.numeric.float.fluxr"
        },
        { "match": "(?<!\\S)[+-]?[0-9]+(?=[\\s#]|$)", "name": "constant.numeric.integer.fluxr" },
        { "match": "(?<!\\S)(?:guard|\\?)(?=[\\s#]|$)", "name": "keyword.control.fluxr" },
        { "match": "(?<!\\S)(?:f(?:<=|[<+*/-])|[+*/%<=&mM-])(?=[\\s#]|$)", "name": "keyword.operator.fluxr" }
      ]
    },
    "compact": {
      "patterns": [
        {
          "match": "(\\()\\s*(pub|fn|rec|enum)\\s+(?:([A-Za-z_][A-Za-z_0-9]*)(\\.))?([A-Za-z_][A-Za-z_0-9]*)(?=[\\s()]|$)",
          "captures": {
            "1": { "name": "punctuation.section.group.begin.fluxr" },
            "2": { "name": "keyword.declaration.fluxr" },
            "3": { "name": "entity.name.type.fluxr" },
            "4": { "name": "punctuation.accessor.fluxr" },
            "5": { "name": "entity.name.fluxr" }
          }
        },
        {
          "match": "(\\()\\s*(inputs|pub|fn|rec|enum|if|when|while|scan|break|continue|ret|find|indices|\\?)(?=[\\s()]|$)",
          "captures": {
            "1": { "name": "punctuation.section.group.begin.fluxr" },
            "2": { "name": "keyword.control.fluxr" }
          }
        },
        {
          "match": "(\\()\\s*(abs|tof|i64tof|ftoi64|sqrt|new|list|local|input|field|at|empty|last|minidx|tag|is|payload|m|call|push|pop)(?=[\\s()]|$)",
          "captures": {
            "1": { "name": "punctuation.section.group.begin.fluxr" },
            "2": { "name": "support.function.fluxr" }
          }
        },
        {
          "match": "(\\()\\s*(&&?|\\|\\|?|==|<=|[!+*/%<=-])(?=[\\s()]|$)",
          "captures": {
            "1": { "name": "punctuation.section.group.begin.fluxr" },
            "2": { "name": "keyword.operator.fluxr" }
          }
        },
        {
          "match": "([A-Za-z_][A-Za-z_0-9]*)(:)",
          "captures": {
            "1": { "name": "variable.parameter.fluxr" },
            "2": { "name": "punctuation.separator.type.fluxr" }
          }
        },
        { "match": "(?<![^\\s(])\\$[A-Za-z_][A-Za-z_0-9]*", "name": "variable.other.input.fluxr" },
        { "match": "[#@][A-Za-z_][A-Za-z_0-9]*", "name": "entity.name.type.fluxr" },
        { "match": "(?<![\\w$.])(?:true|false|unit)(?=[\\s()]|$)", "name": "constant.language.fluxr" },
        { "match": "(?<![\\w$.])(?:unit|bool|i64|u64|f32)(?=[\\s()\\]]|$)", "name": "storage.type.fluxr" },
        { "match": "(?<=[:\\[])[A-Za-z_][A-Za-z_0-9]*", "name": "entity.name.type.fluxr" },
        {
          "match": "(?<![^\\s(])(?:0x[0-9a-fA-F]+|-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|-(?i:inf(?:inity)?|nan))f(?=[\\s()]|$)",
          "name": "constant.numeric.float.fluxr"
        },
        { "match": "(?<![^\\s(])(?:[0-9]+u|-?[0-9]+)(?=[\\s()]|$)", "name": "constant.numeric.integer.fluxr" },
        { "match": "(?<![^\\s(])=(?=[\\s()]|$)", "name": "keyword.operator.fluxr" },
        { "match": "\\(", "name": "punctuation.section.group.begin.fluxr" },
        { "match": "\\)", "name": "punctuation.section.group.end.fluxr" },
        { "match": "[\\[\\]]", "name": "punctuation.section.brackets.fluxr" },
        { "match": "\\.", "name": "punctuation.accessor.fluxr" }
      ]
    }
  }
}
