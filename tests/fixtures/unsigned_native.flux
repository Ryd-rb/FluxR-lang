v2
(rec Signed value:i64)
(fn increment (x:u64) u64 = (+ x 1u))
(pub add (x:u64 y:u64) u64 = (+ x y))
(pub sub (x:u64 y:u64) u64 = (- x y))
(pub mul (x:u64 y:u64) u64 = (* x y))
(pub eq (x:u64 y:u64) bool = (== x y))
(pub lt (x:u64 y:u64) bool = (< x y))
(pub le (x:u64 y:u64) bool = (<= x y))
(pub literal () u64 = 18446744073709551615u)
(pub choose (quick:bool x:u64) u64 ()
  (if quick ((ret x)) ((ret (call increment x)))))
(pub walk (n:u64 start:u64) u64 (i:u64 total:u64)
  (= i 0u) (= total start)
  (while (< i n)
    ((= total (call increment total)) (= i (+ i 1u))))
  (ret total))
(pub arithmetic_first (x:u64) u64 (bad:u64 unset:u64)
  (= bad (+ x 1u)) (ret unset))
(pub uninitialized_first (x:u64) u64 (unset:u64)
  (ret (+ unset (+ x 1u))))
(pub record_to_unsigned (s:Signed x:i64) u64 = 18446744073709551615u)
(pub keep_record (s:Signed x:u64) Signed = s)
