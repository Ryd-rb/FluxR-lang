{
  "version": 1,
  "inputs": [{"name":"bonus","ty":"i64"}],
  "records": [{"name":"Counter","fields":[{"name":"total","ty":"i64"}]}],
  "functions": [
    {
      "name":"adjust",
      "params":[{"name":"i","ty":"i64"}],
      "result":"i64",
      "body":[
        {"op":"return","value":{"op":"binary","kind":"mul","left":{"op":"local","name":"i"},"right":{"op":"i64","value":2}}}
      ]
    },
    {
      "name":"advance","receiver":"Counter",
      "params":[{"name":"self","ty":{"record":"Counter"}},{"name":"count","ty":"i64"}],
      "locals":[{"name":"i","ty":"i64"},{"name":"change","ty":"i64"}],
      "result":{"record":"Counter"},
      "body":[
        {"op":"set","local":"i","value":{"op":"i64","value":0}},
        {"op":"while","test":{"op":"binary","kind":"lt","left":{"op":"local","name":"i"},"right":{"op":"local","name":"count"}},"body":[
          {"op":"if","test":{"op":"binary","kind":"eq","left":{"op":"binary","kind":"rem","left":{"op":"local","name":"i"},"right":{"op":"i64","value":2}},"right":{"op":"i64","value":0}},
            "then":[{"op":"set","local":"change","value":{"op":"input","name":"bonus"}}],
            "otherwise":[{"op":"set","local":"change","value":{"op":"call","name":"adjust","args":[{"op":"local","name":"i"}]}}]},
          {"op":"set_field","local":"self","field":"total","value":{"op":"binary","kind":"add","left":{"op":"field","name":"total","record":{"op":"local","name":"self"}},"right":{"op":"local","name":"change"}}},
          {"op":"set","local":"i","value":{"op":"binary","kind":"add","left":{"op":"local","name":"i"},"right":{"op":"i64","value":1}}}
        ]},
        {"op":"return","value":{"op":"local","name":"self"}}
      ]
    },
    {
      "name":"tick","export":true,
      "params":[{"name":"state","ty":{"record":"Counter"}},{"name":"count","ty":"i64"}],
      "result":{"record":"Counter"},
      "body":[{"op":"return","value":{"op":"method","name":"advance","receiver":{"op":"local","name":"state"},"args":[{"op":"local","name":"count"}]}}]
    }
  ]
}
