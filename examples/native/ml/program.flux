v2
(rec Dual value tangent:f32)
(fn add (a b:Dual) Dual = (new Dual (+ a.value b.value) (+ a.tangent b.tangent)))
(fn mul (a b:Dual) Dual = (new Dual (* a.value b.value) (+ (* a.tangent b.value) (* a.value b.tangent))))
(fn relu (a:Dual) Dual = (? (< 0f a.value) a (new Dual 0f 0f)))
(fn seed (direction expected:f32) f32 = (? (== direction expected) 1f 0f))
(fn selected (w b v c direction:f32) f32 = (? (== direction 0f) w (? (== direction 1f) b (? (== direction 2f) v c))))
(fn derivative (x y w b v c direction:f32) f32 (hidden output error:Dual)
 (= hidden (relu (add (mul (new Dual w (seed direction 0f)) (new Dual x 0f)) (new Dual b (seed direction 1f)))))
 (= output (add (mul hidden (new Dual v (seed direction 2f))) (new Dual c (seed direction 3f))))
 (= error (add output (new Dual (- 0f y) 0f)))
 (ret (* error.value error.tangent)))
(pub predict (x w b v c:f32) f32 (hidden:f32)
 (= hidden (+ (* w x) b))
 (if (< hidden 0f) ((= hidden 0f)))
 (ret (+ (* hidden v) c)))
(pub loss (x y w b v c:f32) f32 (error:f32)
 (= error (- (predict x w b v c) y))
 (ret (* 0.5f (* error error))))
(pub gradient (x y w b v c direction:f32) f32 = (derivative x y w b v c direction))
(pub step (x y w b v c rate direction:f32) f32 = (- (selected w b v c direction) (* rate (derivative x y w b v c direction))))
(pub affine (x weight bias:f32) f32 = (+ (* x weight) bias))
(pub stump (x threshold low high:f32) f32 = (? (< x threshold) low high))
(pub cluster (x center0 center1:f32) f32 = (? (! (< (* (- x center1) (- x center1)) (* (- x center0) (- x center0)))) 0f 1f))
(pub kernel (x center scale:f32) f32 = (/ 1f (+ 1f (* scale (* (- x center) (- x center))))))
