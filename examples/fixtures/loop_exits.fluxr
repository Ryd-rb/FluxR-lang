v2
(rec State total:i64 marker:i64)
(fn positive (total:i64 divisor:i64) bool ()
  (ret (< 0 (/ total divisor))))
(pub choose (state:State enabled:bool left:i64 right:i64) State ()
  (if (| (& enabled (call positive state.total left))
         (call positive state.total right))
    ((= state.total (+ state.total 1))) ())
  (ret state))
(pub walk (state:State n:i64 stop:i64 skip:i64 step:i64) State (total:i64)
  (= total state.total)
  (while (< 0 n) (
    (= n (- n 1))
    (if (== n stop) ((break)) ())
    (if (< n skip) ((continue)) ())
    (= total (+ total (/ step n)))))
  (if (== total state.total) ((ret state)) ())
  (= state.total total)
  (ret state))
